# =============================================================================
# .gitignore — Ascendo
# =============================================================================
# Excludes machine-specific generated files, runtime caches, build outputs,
# secrets, and editor metadata. Keep .gitattributes for line-ending policy.
# =============================================================================

# ── Machine-specific inventory (generated per-machine, never committed) ──────
APPS.md
APPLICATIONS.md
PROGRAMS.md
PROGRAMS.json
UPDATES.md

# ── Runtime logs ─────────────────────────────────────────────────────────────
logs/
*.log
!**/example.log
!**/sample.log
**/Logs/
dev_sync_logs/

# ── Build outputs ────────────────────────────────────────────────────────────
dist/
build/
target/
out/
*.egg-info/
*.egg
__pycache__/

# Tauri sidecar staging — populated by bin/build-installer.ps1 from the
# PyInstaller bundle. The exe + _internal/ tree is too large to commit.
ui/desktop-tauri/src-tauri/binaries/

# Tauri build needs installer assets + LICENSE inside src-tauri/ because
# Tauri's path resolution chokes on `..` segments crossing the workspace
# root. We treat the src-tauri/ copies as build-time artefacts and let
# `bin/build-installer.ps1` populate them from the canonical sources
# under `packaging/installer-assets/` and the repo root LICENSE.
ui/desktop-tauri/src-tauri/installer-assets/
ui/desktop-tauri/src-tauri/LICENSE
ui/desktop-tauri/src-tauri/first-run-bootstrap-macos.sh
ui/desktop-tauri/src-tauri/bin-staging/

# Throw-away preview PNGs from the installer-assets generator.
packaging/installer-assets/_preview-*.png
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ── Tauri / Rust build ───────────────────────────────────────────────────────
**/src-tauri/target/
**/src-tauri/Cargo.lock
# Icons are committed (regenerated via bin/regenerate-icons.sh) so the
# build doesn't depend on a local rasterization toolchain. The legacy
# wildcard `**/src-tauri/icons/` is intentionally NOT here.
**/src-tauri/gen/

# ── PyInstaller ──────────────────────────────────────────────────────────────
*.manifest
*.spec.bak

# ── Python virtualenvs ───────────────────────────────────────────────────────
.venv/
venv/
ENV/
env/
**/app/.venv/
core/.venv/
adapters/*/.venv/

# ── SQLite (per-user dashboard history) ──────────────────────────────────────
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── Config backups (auto-discovery mode) ─────────────────────────────────────
config/*.bak_*
**/config/hosts.toml
**/config/hosts.local.toml

# ── Dev sync private overlay runtime state ───────────────────────────────────
.dev_sync_config.json
.dev_sync_manifest.json
dev_sync_quarantine/
dev_sync_cleanup_plan*.json
.sync-state/
config/dev-sync-*.local
*.rclone.conf

# ── Agent runtime caches ─────────────────────────────────────────────────────
.codex.local/tmp/

# ── Graphify runtime internals (reports may be tracked separately) ───────────
graphify-out/cache/
graphify-out/converted/
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/.graphify_*

# ── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Claude Code internal settings (machine-local) ────────────────────────────
.claude/
.cursor/
.aider*

# ── Secrets — never commit ───────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.template
*.env
*.local.json
*.local.yml
*.local.yaml
*.local.toml
secrets/
credentials/
**/api_keys.json
*.key
*.pem
!tests/fixtures/**/*.key
!tests/fixtures/**/*.pem

# ── SSH ──────────────────────────────────────────────────────────────────────
github
github.pub
*.id_rsa
*.id_ed25519

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
.npm/
.pnpm-store/
.yarn/

# ── Astro / website ──────────────────────────────────────────────────────────
website/node_modules/
website/.astro/
website/dist/
website/.cache/

# ── macOS-specific (when developing on macOS) ────────────────────────────────
.AppleDouble
.LSOverride
Icon
._*

# ── Windows-specific ─────────────────────────────────────────────────────────
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# ── Cowork session leftovers ─────────────────────────────────────────────────
.write-test
.cowork-test

# ── Browser-automation captures (Playwright MCP debug output) ────────────────
.playwright-mcp/
dashboard-overview-*.png
dashboard-*.png

# ── Edition split (Sesja 51, revised Sesja 52): private files only ─
# These live in the working tree for dev-edition users (because dev-sync
# pushes them to Proton), but must never be committed to the public repo.
#
# Important: the dev-sync TOOLING (Python lib + wrapper scripts) STAYS in
# the public repo — it's generic rclone-wrapper code anyone can use with
# their own provider. Only the per-user CONFIG (Proton paths, payload)
# is private. Same logic applies to AI instructions: the .example stubs
# are public; the real CLAUDE.md / AGENTS.md / CODEX.md with project-
# specific instructions are private.

# AI instructions (real content — agent-readable, project-specific)
/CLAUDE.md
/AGENTS.md
/CODEX.md
/.claude/
/.claudeignore
/.codex
/.codex.local/
/.codexignore
/.gemini/
/.geminiignore
/.graphifyignore

# Internal handoffs / roadmap / session logs (313KB + 44KB)
/HANDOFF.md
/PLAN.md
/DEV_SCRIPTS_README.md
/docs/superpowers/specs/

# Graphify output (knowledge graphs — user-specific)
/graphify-out/

# Per-user dev-sync config + payload (paths + cloud credentials)
/.dev_sync_config.json
/.dev_sync_manifest.json
/dev_sync_logs/
/dev-sync-overlay/

# NOTE: dev-sync/ Python lib + dev-sync-*.{sh,ps1} wrappers are NOT
# gitignored here. They are GENERIC tooling (rclone wrappers, no user
# data) and stay in the public repo so dev-edition users can clone +
# install + bootstrap their own overlay against their own provider.
/dev-sync-overlay/

# Build artefacts
/dist/
