#!/usr/bin/env bash
# gemini CLI 0.42 emits stream-json with `init` then `message`
# (role=assistant) then `result` events. The Ascendo driver invokes
# with `--output-format stream-json --skip-trust`; this fake mirrors
# that contract.
set -e
case "${FIXTURE_CASE:-success}" in
  version) echo "0.42.0"; exit 0 ;;
  auth_probe_ok)
    printf '{"type":"init","model":"gemini-3-flash"}\n'
    printf '{"type":"message","role":"assistant","content":"ok"}\n'
    printf '{"type":"result","status":"success"}\n'
    exit 0 ;;
  auth_expired) echo "Error: not authenticated" >&2; exit 1 ;;
  crash) exit 137 ;;
  hang) sleep 600 ;;
  partial_then_eof)
    printf '{"type":"init","model":"gemini-3-flash"}\n'
    printf '{"type":"message","role":"assistant","content":"partial"}\n'
    exit 1 ;;
  success|*)
    printf '{"type":"init","model":"gemini-3-flash"}\n'
    printf '{"type":"message","role":"user","content":"prompt"}\n'
    printf '{"type":"message","role":"assistant","content":"Hello world"}\n'
    printf '{"type":"result","status":"success","stats":{"output_tokens":2}}\n'
    exit 0 ;;
esac
