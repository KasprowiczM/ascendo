{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "Ascendo",
  "version": "0.0.7",
  "identifier": "dev.ascendo.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Ascendo - Unified Updates",
    "longDescription": "Ascendo desktop shell. Spawns the Python dashboard sidecar on a loopback port and opens it in a WebView2 window. Bundles a Python runtime so the user does not need Python installed.",
    "category": "DeveloperTool",
    "publisher": "Ascendo Software",
    "copyright": "Copyright (c) 2026 KasprowiczM and Ascendo contributors",
    "homepage": "https://github.com/KasprowiczM/ascendo",
    "license": "MIT",
    "licenseFile": "LICENSE",
    "resources": [
      "binaries/python-sidecar"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "wix": {
        "language": ["en-US"],
        "upgradeCode": "5C9E0E4F-5A1A-4F7C-B3F6-2E2C2C5B5C5C",
        "bannerPath": "installer-assets/installer-banner-wix.bmp",
        "dialogImagePath": "installer-assets/installer-sidebar-wix.bmp"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer-assets/installer-banner-nsis.bmp",
        "sidebarImage": "installer-assets/installer-sidebar-nsis.bmp",
        "compression": "lzma",
        "installerHooks": "installer-assets/nsis-installer-hooks.nsh"
      }
    }
  }
}
