{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "Ascendo",
  "version": "1.0.3",
  "identifier": "dev.ascendo.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "shortDescription": "Ascendo - Unified Updates",
    "longDescription": "Ascendo desktop shell. Spawns the Python dashboard sidecar on a loopback port and opens it in a native webview window (WebView2 on Windows, WKWebView on macOS, WebKitGTK on Linux). On Windows, bundles a Python runtime so the user does not need Python installed; on macOS/Linux, requires system Python 3.11+.",
    "category": "DeveloperTool",
    "publisher": "Ascendo Software",
    "copyright": "Copyright (c) 2026 KasprowiczM and Ascendo contributors",
    "homepage": "https://github.com/KasprowiczM/ascendo",
    "license": "MIT",
    "licenseFile": "LICENSE",
    "resources": [
      "first-run-bootstrap-macos.sh",
      "bin-staging/**/*"
    ],
    "windows": {
      "digestAlgorithm": "sha256"
    }
  }
}
